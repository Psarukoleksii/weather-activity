# Copy to .env to override. docker compose reads this file first and .env (optional) on top.
# Postgres (src/libs/typeorm)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=weather
DB_USER=app
DB_PASSWORD=app
DB_POOL_SIZE=10
# true | false | all | comma-separated: query,error,warn,info,log,schema,migration
DB_LOGGING=error,warn,migration
# Queries slower than this are logged as slow
DB_MAX_QUERY_EXECUTION_TIME_MS=500
# TLS to Postgres. Without file paths the system CAs are used; paths are resolved from the run dir
DB_SSL=false
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_REJECT_UNAUTHORIZED=true

# Rate limit counters (api only)
REDIS_URL=redis://redis:6379
PORT=3000

# Rate limit per IP: THROTTLE_LIMIT requests per THROTTLE_TTL_SECONDS
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=60

# Timeout of a single Open-Meteo call
OPENMETEO_CALL_TIMEOUT_SECONDS=4

# Worker: how often it polls Postgres, places per tick, pause before retrying a failing place
WORKER_POLL_INTERVAL_SECONDS=60
WORKER_BATCH_SIZE=10
WORKER_RETRY_AFTER_MINUTES=15

# Data older than this is refreshed synchronously inside the request
SYNC_REFRESH_AFTER_HOURS=24
# Background refresh: hot = requested within 24 h, warm = within 7 days
HOT_REFRESH_HOURS=3
WARM_REFRESH_HOURS=12

# Skiing is applicable only at or above this elevation
SKI_MIN_ELEVATION_M=300

# How long an unknown city is remembered in Redis, so repeats do not call the geocoder (api only)
GEOCODE_NOT_FOUND_TTL_SECONDS=3600
